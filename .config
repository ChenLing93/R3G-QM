# ============================================================
# 小米路由器 3G (Xiaomi Mi Router 3G) · ramips/mt7621 · ImmortalWrt 24.10
# ------------------------------------------------------------
# 这里只声明「目标设备 + 需要的软件包」，具体依赖由 make defconfig 展开。
# 规则：只写源码 / feed 里真实存在的包名，否则会被 defconfig 静默丢弃，
#       编出来的固件会「看着成功、功能缺失」。CI 里有一道校验会拒绝这种结果。
# ============================================================

# ---------- 目标平台与设备 ----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-3g=y

# ---------- 根文件系统：只出 SquashFS ----------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=n

# ---------- 编译加速（CI 里装了 ccache）----------
CONFIG_CCACHE=y

# ---------- LuCI 主题：Aurora ----------
# 主题是独立包，由 diy.sh 克隆到 package/ 里，包名就是 luci-theme-aurora
CONFIG_PACKAGE_luci-theme-aurora=y

# ---------- QModem 4G/5G 模组管理 ----------
# 新版 JS 前端。它依赖 qmodem 主包 + sms-forwarder-next，全部来自 QModem feed
# （feed 由 diy.sh 写进 feeds.conf.default，不使用旧版 luci-app-qmodem，避免拖入 luci-compat）
CONFIG_PACKAGE_luci-app-qmodem-next=y

# ---------- 网络插件 ----------
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# ---------- 微信推送 ----------
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_luci-i18n-wechatpush-zh-cn=y

# ---------- 短信 / SIM 状态 ----------
# 24.10 里 LuCI 短信界面叫 luci-app-sms-tool-js；gammu 在包里只有一个包名（没有 gammu-smsd / libgammu 子包）
CONFIG_PACKAGE_luci-app-sms-tool-js=y
CONFIG_PACKAGE_luci-i18n-sms-tool-js-zh-cn=y
CONFIG_PACKAGE_sms-tool=y
CONFIG_PACKAGE_gammu=y

# ---------- USB 与模组驱动（QModem 跑得起来的前提）----------
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
# 串口：AT 口
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
# 数据口：QMI / MBIM / NCM / RNDIS
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_uqmi=y

# ---------- 排障工具 ----------
CONFIG_PACKAGE_usbutils=y
